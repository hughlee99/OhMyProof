{
  "version": 1,
  "question": "Which retrieval strategy works best under exact, typo, alias, and follow-up queries?",
  "candidates": [
    {"id":"full","label":"Full Context","env":{"METHOD":"full"}},
    {"id":"token","label":"Token Match","env":{"METHOD":"token"}},
    {"id":"char","label":"Character n-gram","env":{"METHOD":"char"}},
    {"id":"char_recent","label":"Character n-gram + Recent Context","env":{"METHOD":"char_recent"}}
  ],
  "worlds": [
    {"id":"explore-1","split":"explore","env":{"SEED":"11","CONTEXTS":"120","QUERIES":"300"}},
    {"id":"cal-1","split":"calibration","env":{"SEED":"21","CONTEXTS":"160","QUERIES":"400"}},
    {"id":"cal-2","split":"calibration","env":{"SEED":"22","CONTEXTS":"160","QUERIES":"400"}},
    {"id":"heldout-1","split":"heldout","env":{"SEED":"31","CONTEXTS":"160","QUERIES":"400"}},
    {"id":"heldout-2","split":"heldout","env":{"SEED":"32","CONTEXTS":"160","QUERIES":"400"}}
  ],
  "sweep": {"TOP_K":[5,10,20]},
  "simulations": [
    {"id":"retrieval","title":"Synthetic retrieval workload","category":"behavior","argv":["node","examples/retrieval-campaign/sim/run.mjs"],"repeats":1,"timeoutMs":120000,"expectExitCode":0}
  ],
  "metrics": [
    {"name":"recall","direction":"higher"},
    {"name":"context_tokens","direction":"lower"},
    {"name":"latency_ms","direction":"lower"}
  ],
  "selection": {
    "split":"calibration",
    "constraints":[{"metric":"recall","stat":"min","operator":">=","value":0.99}],
    "objective":{"metric":"context_tokens","stat":"mean","direction":"lower"}
  },
  "failureMining":{"enabled":true},
  "unknowns":[
    "Synthetic query generation does not represent real production language.",
    "The demo does not model external embedding APIs or networked vector databases.",
    "Latency is machine-dependent and only comparable inside the same run."
  ]
}
